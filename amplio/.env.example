# Amplio local environment — TEMPLATE. Copy to `.env.local` and fill in.
# `.env.local` is gitignored and must never be committed.
#
# Bearer token for the GitHub Copilot OpenAI-compatible endpoint used in
# ~/.amplio/config.toml (api_key_env=COPILOT_TOKEN). This token is SHORT-LIVED
# (~30 min); refresh it and restart `amplio serve` when runs start failing with
# "missing required Authorization header".
COPILOT_TOKEN=

# Optional: native Anthropic API key (activates the claude:* models in config).
# ANTHROPIC_API_KEY=

# Bind address for the server.
AMPLIO_LISTEN=0.0.0.0:26759
